  <Product Name='CaptureProbe' Id='*' UpgradeCode='9F6B8AE2-0F77-4FA9-84BA-CA3DE9CFA422'
    Language='1033' Codepage='1252' Version='$(env.RENDERCCCCC_VERSION).0' Manufacturer='Baldur Karlsson'>

    <Package Id='*' Keywords='Installer' Description="Installer for CaptureProbe"
      Comments='CaptureProbe local test build based on Renderccccc (https://renderccccc.org/)' Platform="x64" Manufacturer='Baldur Karlsson'
      InstallerVersion='301' Languages='1033' Compressed='yes' SummaryCodepage='1252' />

    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize"/>
    </InstallExecuteSequence>

    <Property Id="MajorMinorVersion">$(env.RENDERCCCCC_VERSION)</Property>

    <Property Id="REINSTALLMODE" Value="amus"/> 

    <Upgrade Id="9F6B8AE2-0F77-4FA9-84BA-CA3DE9CFA422">
      <UpgradeVersion Minimum="0.18.0"
        IncludeMinimum="yes"
        IncludeMaximum="yes"
        Maximum="$(env.RENDERCCCCC_VERSION).0"
        Property="OLDERVERSIONBEINGUPGRADED" />
      <UpgradeVersion OnlyDetect="yes" Property="NEWERVERSIONDETECTED" Minimum="$(env.RENDERCCCCC_VERSION).0" IncludeMinimum="no" />
    </Upgrade>

    <Condition Message="A later version of [ProductName] is already installed">
      NOT NEWERVERSIONDETECTED
    </Condition>

    <Media Id='1' Cabinet='captureprobe.cab' EmbedCab='yes' CompressionLevel='high' DiskPrompt="CD-ROM #1" />
    <Property Id='DiskPrompt' Value="CaptureProbe Installation [1]" />

